{
  "name": "calsci",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "CalSci : Scientific Calculator. Offline scientific calculator and lightweight CAS.",
  "scripts": {
    "dev": "vite",
    "build": "npm run fetch:pyodide && tsc -b && vite build",
    "build:native": "npm run fetch:pyodide && tsc -b && vite build --mode native",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs",
    "cap:sync": "npm run build:native && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@cortex-js/compute-engine": "^0.148.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "comlink": "^4.4.2",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.6",
    "jstat": "^1.9.6",
    "mathjs": "^15.2.0",
    "mathlive": "^0.111.0",
    "pyodide": "^314.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-statistics": "^7.12.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
